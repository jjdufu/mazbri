# 【生产】环境变量 / Production Environment Variables

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
# Application base path (e.g., /admin/ if deployed in subdirectory)
VITE_BASE_URL = /

# API 请求基础路径（生产环境设置为相对路径 /，由后端提供服务）
# API base URL (use relative path / in production, served by backend)
VITE_API_URL = /

# 租户网关入口（接入向导成功页 curl；部署时改成真实 gateway）

# Delete console in production / 生产环境删除 console
VITE_DROP_CONSOLE = true

# 应用版本 / Application Version
VITE_VERSION = 0.0.1
