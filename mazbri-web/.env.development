# 【开发】环境变量 / Development Environment Variables

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
# Application base path (e.g., /admin/ if deployed in subdirectory)
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
# API base URL (use / for proxy in development, full URL in production)
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
# Proxy target URL (Vite proxy forwards requests to this address in development)
VITE_API_PROXY_URL = http://127.0.0.1:8085

# 租户网关入口（接入向导成功页 curl 示例用；按环境改）
# Tenant-facing API gateway base URL for onboarding curl sample
VITE_GATEWAY_URL = http://gateway.mazbri.local:8080

# Delete console
VITE_DROP_CONSOLE = false

# 应用版本 / Application Version
VITE_VERSION = 0.0.1

# 开发服务器端口 / Development server port
VITE_PORT = 5173
