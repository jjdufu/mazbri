# 复制为 .migration/.env.local 后填写真实本地测试凭据（该文件已被 .gitignore 忽略，严禁提交到 Git！）
# 用于 Stage 2~6 的 chrome-devtools MCP 与 gate-3 无人值守全链路自测

TARGET_URL=http://192.168.50.50:8085
CDP_HOST=127.0.0.1
CDP_PORT=9224

# 运行中需要热替换二进制的 Docker 容器名（留空则自动探测运行中的 mazbri-mgmt / mazbri-max 容器）
MGMT_CONTAINER=

# 管理员测试账号（R_ADMIN）
TEST_ADMIN_USERNAME=jwczjzl
TEST_ADMIN_PASSWORD=
# 标准 Base32 TOTP 密钥（仅用于测试环境合法计算 6 位 RFC 6238 动态码填入 MFA，绝不绕过后端校验）
TEST_ADMIN_TOTP_SECRET=

# 可选：财务角色与只读角色测试账号（用于 Stage 6 三角色权限矩阵验收）
TEST_FINANCE_USERNAME=
TEST_FINANCE_PASSWORD=
TEST_FINANCE_TOTP_SECRET=

TEST_VIEWER_USERNAME=tenant_viewer
TEST_VIEWER_PASSWORD=
TEST_VIEWER_TOTP_SECRET=
